<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.chesstrainerfx.controller.PositionEditorController"
      alignment="CENTER" spacing="10" stylesheets="@../css/position-editor.css">

    <!-- Scanpaneel: permanent zichtbaar; inhoud (ImageScanPane) komt uit de controller.
         Verticaal gecentreerd op het bordmidden: de top-padding compenseert de titel boven het bord. -->
    <VBox fx:id="scanColumn" alignment="CENTER">
        <padding><Insets top="50" left="10"/></padding>
    </VBox>

    <!-- Bordkolom: titel, zwarte stukken, bord, witte stukken, FEN (gevuld in de controller) -->
    <VBox fx:id="boardColumn" spacing="10">
        <padding><Insets left="10"/></padding>
    </VBox>

    <!-- Zijpaneel -->
    <VBox spacing="10" prefWidth="340" maxWidth="340">
        <padding><Insets top="10" left="20"/></padding>

        <HBox spacing="5" alignment="CENTER_RIGHT">
            <Label text="Category:" styleClass="editor-label-bold" minWidth="-Infinity"/>
            <Label fx:id="categoryPathLbl" styleClass="editor-label" maxWidth="120"/>
            <Button text="Set category" onAction="#onSetCategory" minWidth="-Infinity" styleClass="editor-btn"/>
            <Label fx:id="categoryStatusLbl" text="☒"
                   style="-fx-text-fill: red; -fx-font-weight: bold; -fx-font-size: 20px"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <padding><Insets top="100"/></padding>
            <Button text="Start Position" minWidth="150" onAction="#onStartPosition" styleClass="editor-btn"/>
            <Button text="Clear Board" minWidth="150" onAction="#onClearBoard" styleClass="editor-btn"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Flip Board" minWidth="150" onAction="#onFlipBoard" styleClass="editor-btn"/>
            <Button text="Export FEN" minWidth="150" onAction="#onExportFen" styleClass="editor-btn"/>
        </HBox>

        <VBox alignment="CENTER">
            <HBox spacing="8" alignment="CENTER">
                <Label text="Moves" styleClass="editor-label-bold"/>
                <Button text="Convert" onAction="#onConvertMoves" minWidth="-Infinity" styleClass="editor-btn"/>
            </HBox>
            <TextArea fx:id="movesWindow" maxWidth="310" maxHeight="90" prefHeight="90" styleClass="editor-textarea"/>
        </VBox>

        <VBox alignment="CENTER">
            <Label text="Comments" styleClass="editor-label-bold"/>
            <TextArea fx:id="commentsWindow" maxWidth="310" maxHeight="100" prefHeight="100" wrapText="true" styleClass="editor-textarea"/>
        </VBox>

        <VBox alignment="CENTER">
            <Label text="Notes" styleClass="editor-label-bold"/>
            <TextArea fx:id="notesWindow" maxWidth="310" maxHeight="90" prefHeight="90" wrapText="true" styleClass="editor-textarea"/>
        </VBox>

        <HBox alignment="CENTER">
            <ComboBox fx:id="whoseTurnSelector" styleClass="editor-combo"/>
        </HBox>

        <HBox alignment="CENTER">
            <Label text="Castling" styleClass="editor-label-bold"/>
        </HBox>

        <HBox spacing="4" alignment="CENTER">
            <Label text="White" styleClass="editor-label"/>
            <CheckBox fx:id="whiteKingSideCastling"/>
            <Label text="O-O" styleClass="editor-label"/>
            <CheckBox fx:id="whiteQueenSideCastling"/>
            <Label text="O-O-O" styleClass="editor-label"/>
        </HBox>

        <HBox spacing="4" alignment="CENTER">
            <Label text="Black" styleClass="editor-label"/>
            <CheckBox fx:id="blackKingSideCastling"/>
            <Label text="O-O" styleClass="editor-label"/>
            <CheckBox fx:id="blackQueenSideCastling"/>
            <Label text="O-O-O" styleClass="editor-label"/>
        </HBox>

        <HBox alignment="CENTER" maxWidth="310">
            <padding><Insets top="10"/></padding>
            <Button text="Save exercise" onAction="#onSaveExercise" minWidth="150" styleClass="editor-btn"/>
        </HBox>
    </VBox>
</HBox>
